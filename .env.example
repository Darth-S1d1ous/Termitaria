# Termitaria runtime configuration.
# Copy this file to .env and fill the keys. `make up` loads .env.
# All API keys live in this file. The app does not read ~/.secrets.

# ---- Required: Nebius Token Factory + NVIDIA Nemotron ----
MODEL_PROVIDER=nebius-token-factory
MODEL_CLOUD_ENABLED=1
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_TIER_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_TIER_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
DEFAULT_MODEL_ID=nebius-nemotron-super
# Graphiti uses the same Nebius key. Set MEMORY_LLM_API_KEY to use a different one.
MEMORY_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# MEMORY_LLM_API_KEY=
# MEMORY_LLM_BASE_URL=

# ---- Required for web search: Tavily (default) ----
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional Brave fallback. Set SEARCH_PROVIDER=brave to use it.
# BRAVE_API_KEY=

# ---- Optional: other providers in the model picker ----
# DeepSeek official API. With the default Nebius config, the DeepSeek
# picker entries run on Token Factory and this key is not used.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Direct NVIDIA API Catalog (not through Nebius)
# NVIDIA_API_KEY=
# NVIDIA_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# ---- Memory backend ----
MEMORY_BACKEND=agent

# ---- Local infrastructure (docker compose defaults) ----
NATS_URL=nats://localhost:4222
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
POSTGRES_DSN=postgresql://termitaria:termitaria@localhost:5432/termitaria
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ---- Worker ----
# Leave empty to serve every agent. A comma-separated list limits the worker.
WORKER_AGENTS=
WORKER_CONCURRENCY=4
