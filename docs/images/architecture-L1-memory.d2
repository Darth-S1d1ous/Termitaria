vars: {
  d2-config: {
    sketch: false
    theme-id: 200
  }
}

direction: down

title: "Termitaria L1 — Project Memory (Python intelligence plane)" {
  near: top-center
  shape: text
  style.font-size: 22
}

mesh: "Agent Mesh\ndispatcher prefetches before enqueue" {shape: rectangle; style.stroke-dash: 4}

mem: "Memory Service\none agent only" {
  style.border-radius: 8
  rec: "Recall\nfilter by kind · top_k"
  wr: "Write episode\nthis agent only"
  pol: "Policy\nwhat persists · decay"
}

kgs: "Knowledge Graph Service\none project only" {
  style.border-radius: 8
  query: "Query subgraph"
  upsert: "Upsert node / edge"
}

kg: "Knowledge Graph\none graph per project" {
  style.border-radius: 8
  store: "FalkorDB"
  ingest: "Ingest pipeline\nchunk → embed → extract"
  nodes: "DOCUMENT · PAPER · CLAIM · CONCEPT"
  edges: "cites · derives · depends · supports · contradicts"
}

am: "Agent Memory\none store per agent" {
  style.border-radius: 8
  pg: "Postgres\nrole · rules · principle · episode"
  recall: "this agent's items only"
}

vec: "Qdrant\nthis agent's episode vectors" {
  style.border-radius: 8
}

llm: "Nebius Token Factory\nNemotron (summarize / extract)" {
  shape: cloud
}

mesh -> mem.rec: "recall(agent_id)"
mesh -> kgs.query: "query this project's subgraph"
mesh -> kg.ingest: "memory.write.document"

kg.ingest -> kgs.upsert: "nodes + edges"
kg.ingest -> llm: "extract claims / citations"
kgs.upsert -> kg.store
kgs.query -> kg.store

mem.wr -> am.pg: "this agent's episode"
mem.rec -> am.recall
am.recall -> vec: "vector search"
am.pg <- mem.pol: "role / rules"

note: |md
  **Two stores, two services. No shared records.**
  - Knowledge Graph = one FalkorDB graph per project
  - Agent memory = one store per agent
  - A recall on one store does not return rows from the other
| {
  near: bottom-center
  shape: text
  style.font-size: 13
}
